# Copy to .env and fill your own values.
# Never commit real secrets.

# Optional remote embedding providers (BYO keys)
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Optional runtime overrides
TRUSTMEM_DIR=
WORKSPACE=
MEM_DIR=
VAULT_DIR=

# Policy selection. POLICY_FILE wins; otherwise the engine reads
# policies/<TRUSTMEM_POLICY_PROFILE>-memory-policy.yaml, defaulting to
# the shipped generic "example" profile.
POLICY_FILE=
TRUSTMEM_POLICY_PROFILE=

# project_id stamped into generated vault front-matter. Falls back to
# scope.project_id from the active policy, then to "default".
TRUSTMEM_PROJECT_ID=

# Project/person scope map (defaults to ./projects-map.yaml).
PROJECT_MAP_FILE=
