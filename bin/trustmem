#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRUSTMEM_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=scripts/lib.sh
source "${TRUSTMEM_DIR}/scripts/lib.sh"

usage() {
  cat <<'USAGE'
Usage:
  trustmem doctor
  trustmem remember "<text>"        Pin to vault immediately
  trustmem ingest "<text>"          Score only, promote later
  trustmem forget "<pattern>"
  trustmem recall "<query>"         Search vault + score metadata
  trustmem sync [--rebuild|--init-promoted]
  trustmem learn <subcommand>       Live-learning engine
  trustmem --version                Print version

Intake options (remember / ingest):
  --confirm             Consent to storing detected sensitive content
  --category <name>     Declare a policy category for the text
  --ambiguous           Mark the text ambiguous (routed to review, not stored)

Learn subcommands:
  score, reinforce, decay, consolidate, promote, prune, status, cycle

  'prune' (alias 'prune-scores') is SCORE-BASED: it drops below-threshold
  entries from the scoring table, the promotion manifest and the generated
  vault. Day-files are an immutable audit trail and are never touched.
  Retention-based archival of day-files is a DIFFERENT operation and is not
  implemented by this engine (see docs/CANONICALIZATION.md).

Environment:
  TRUSTMEM_DIR              Installation root
  WORKSPACE                 Parent of memory/ (defaults to TRUSTMEM_DIR)
  MEM_DIR                   Day-file directory (default WORKSPACE/memory)
  VAULT_DIR                 Generated vault (default TRUSTMEM_DIR/vault)
  POLICY_FILE               Explicit policy path (overrides the profile)
  TRUSTMEM_POLICY_PROFILE   policies/<profile>-memory-policy.yaml
  TRUSTMEM_PROJECT_ID       project_id stamped into generated vault notes
  PROJECT_MAP_FILE          Project/person scope map (default projects-map.yaml)
USAGE
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
shift

case "${cmd}" in
  --version|-v)
    echo "trustmem ${TRUSTMEM_VERSION}"
    ;;
  --help|-h|help)
    usage
    ;;
  doctor)
    exec "${TRUSTMEM_DIR}/scripts/doctor.sh" "$@"
    ;;
  remember|ingest|forget|recall|sync)
    exec "${TRUSTMEM_DIR}/scripts/memoryctl.sh" "${cmd}" "$@"
    ;;
  learn)
    exec "${TRUSTMEM_DIR}/scripts/livelearn.sh" "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
